// TODO change to 1.13
mdl 99.99;

import ::anno::*;
import ::math::*;
import ::state::*;
import ::tex::*;

import .::core::*;
import .::stdlib_1_12::*;

// Remap floor-based integer texel coordinates.
int mx_bspline_remap(int coord, int resolution, tex::wrap_mode wrap)
{
    if (wrap == tex::wrap_clamp || wrap == tex::wrap_clip)
        return math::clamp(coord, 0, resolution - 1);

    if (wrap == tex::wrap_mirrored_repeat)
    {
        int period = 2 * resolution;
        int result = (coord % period + period) % period;
        return result < resolution ? result : period - 1 - result;
    }

    // tex::wrap_repeat
    return (coord % resolution + resolution) % resolution;
}

// Weights of a cubic B-spline including its derivative.
struct mx_bspline_weights {
    float4 value;
    float4 deriv;
};

// Compute weights of a cubic B-spline including its derivative for parameter t.
mx_bspline_weights mx_compute_bspline_weights(float t)
{
    float t2  = t * t;
    float t3  = t2 * t;
    float tmp = 0.5f * t2;

    return mx_bspline_weights(
        float4(
            (-1.0f / 6.0f) * t3 + tmp - 0.5f * t + (1.0f / 6.0f),
                      0.5f * t3 -  t2 +            (4.0f / 6.0f),
                     -0.5f * t3 + tmp + 0.5f * t + (1.0f / 6.0f),
            ( 1.0f / 6.0f) * t3),
        float4(
            -tmp              + t - 0.5f,
             1.5f * t2 - 2.0f * t,
            -1.5f * t2        + t + 0.5f,
            tmp));
}

// The mx_image_with_derivatives_* variants below preserve the ordinary image lookup value and
// supply approximate gradients from B-spline interpolation of texel values. These gradients are
// not generally the derivatives of the returned value. For nonlinear downstream operations, the
// propagated gradients need not match the derivatives of either reconstruction.
//
// Value-only consumers therefore receive the same value whether or not the image also feeds a
// heighttonormal "in" input. When derivatives are unused, the MDL compiler can eliminate the
// additional texel fetches and B-spline calculations.

export float mx_image_with_derivatives_float(
    uniform texture_2d mxp_file = texture_2d()
    [[
        anno::display_name("Filename")
    ]],
    uniform string mxp_layer = string("")
    [[
        anno::display_name("Layer")
    ]],
    float mxp_default = float(0.0)
    [[
        anno::display_name("Default Color")
    ]],
    float2 mxp_texcoord = float2(core::mx_swizzle_xy(::state::texture_coordinate(0)))
    [[
        anno::display_name("Texture Coordinates")
    ]],
    uniform core::mx_addressmode_type mxp_uaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode U")
    ]],
    uniform core::mx_addressmode_type mxp_vaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode V")
    ]],
    uniform core::mx_filterlookup_type mxp_filtertype
        = core::mx_filterlookup_type(core::mx_filterlookup_type_linear)
    [[
        anno::description("Enumeration {closest,linear,cubic}."),
        anno::display_name("Filter Type")
    ]],
    uniform string mxp_framerange = string("")
    [[
        anno::display_name("Frame Range")
    ]],
    uniform int mxp_frameoffset = int(0)
    [[
        anno::display_name("Frame Offset")
    ]],
    uniform core::mx_addressmode_type mxp_frameendaction
        = core::mx_addressmode_type(core::mx_addressmode_type_constant)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Frame End Action")
    ]],
    uniform bool mxp_flip_v = false
    [[
        anno::usage("for applying the 'fileTextureVerticalFlip' shader generator option."),
        anno::hidden()
    ]]
)
    [[
        anno::description("Node Group: texture2d")
    ]]
{
    if (!tex::texture_isvalid(mxp_file))
        return mxp_default;

    uniform int2 resolution = int2(tex::width(mxp_file), tex::height(mxp_file));
    if (resolution.x <= 0 || resolution.y <= 0)
        return mxp_default;

    float value = stdlib_1_12::mx_image_float(
        mxp_file, mxp_layer, mxp_default, mxp_texcoord,
        mxp_uaddressmode, mxp_vaddressmode, mxp_filtertype,
        mxp_framerange, mxp_frameoffset, mxp_frameendaction, mxp_flip_v);

    float2 uv = mxp_flip_v ? float2(mxp_texcoord.x, 1.0 - mxp_texcoord.y) : mxp_texcoord;
    // Map normalized UVs to texel-center coordinates: texel i is at (i + 0.5) / resolution.
    float2 texel_position = uv * float2(resolution) - 0.5;

    // Keep the existing gradient fallback outside the B-spline center domain.
    if (mxp_uaddressmode == core::mx_addressmode_type_constant
        && (texel_position.x < 0.0 || texel_position.x >= float(resolution.x)))
        return float(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));
    if (mxp_vaddressmode == core::mx_addressmode_type_constant
        && (texel_position.y < 0.0 || texel_position.y >= float(resolution.y)))
        return float(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));

    int2 cell = int2(math::floor(texel_position));
    float2 fraction = texel_position - math::floor(texel_position);
    mx_bspline_weights w_u = mx_compute_bspline_weights(fraction.x);
    mx_bspline_weights w_v = mx_compute_bspline_weights(fraction.y);
    uniform tex::wrap_mode wrap_u = core::map_addressmode(mxp_uaddressmode);
    uniform tex::wrap_mode wrap_v = core::map_addressmode(mxp_vaddressmode);

    float du = float(0.0);
    float dv = float(0.0);
    for (int j = 0; j < 4; ++j)
    {
        int y = mx_bspline_remap(cell.y + j - 1, resolution.y, wrap_v);
        float row_value = float(0.0);
        float row_du = float(0.0);
        for (int i = 0; i < 4; ++i)
        {
            int x = mx_bspline_remap(cell.x + i - 1, resolution.x, wrap_u);
            float sample = float(tex::texel_float(mxp_file, int2(x, y)));
            row_value += sample * w_u.value[i];
            row_du += sample * w_u.deriv[i];
        }
        du += row_du * w_v.value[j];
        dv += row_value * w_v.deriv[j];
    }

    // Convert texel derivatives to UV units, then to the application's derivative basis.
    du *= float(resolution.x);
    dv *= float(resolution.y);
    float2 dx = math::DX(uv);
    float2 dy = math::DY(uv);
    return float(math::make_dual(value, du * dx.x + dv * dx.y, du * dy.x + dv * dy.y));
}

export float2 mx_image_with_derivatives_vector2(
    uniform texture_2d mxp_file = texture_2d()
    [[
        anno::display_name("Filename")
    ]],
    uniform string mxp_layer = string("")
    [[
        anno::display_name("Layer")
    ]],
    float2 mxp_default = float2(0.0, 0.0)
    [[
        anno::display_name("Default Color")
    ]],
    float2 mxp_texcoord = float2(core::mx_swizzle_xy(::state::texture_coordinate(0)))
    [[
        anno::display_name("Texture Coordinates")
    ]],
    uniform core::mx_addressmode_type mxp_uaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode U")
    ]],
    uniform core::mx_addressmode_type mxp_vaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode V")
    ]],
    uniform core::mx_filterlookup_type mxp_filtertype
        = core::mx_filterlookup_type(core::mx_filterlookup_type_linear)
    [[
        anno::description("Enumeration {closest,linear,cubic}."),
        anno::display_name("Filter Type")
    ]],
    uniform string mxp_framerange = string("")
    [[
        anno::display_name("Frame Range")
    ]],
    uniform int mxp_frameoffset = int(0)
    [[
        anno::display_name("Frame Offset")
    ]],
    uniform core::mx_addressmode_type mxp_frameendaction
        = core::mx_addressmode_type(core::mx_addressmode_type_constant)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Frame End Action")
    ]],
    uniform bool mxp_flip_v = false
    [[
        anno::usage("for applying the 'fileTextureVerticalFlip' shader generator option."),
        anno::hidden()
    ]]
)
    [[
        anno::description("Node Group: texture2d")
    ]]
{
    if (!tex::texture_isvalid(mxp_file))
        return mxp_default;

    uniform int2 resolution = int2(tex::width(mxp_file), tex::height(mxp_file));
    if (resolution.x <= 0 || resolution.y <= 0)
        return mxp_default;

    float2 value = stdlib_1_12::mx_image_vector2(
        mxp_file, mxp_layer, mxp_default, mxp_texcoord,
        mxp_uaddressmode, mxp_vaddressmode, mxp_filtertype,
        mxp_framerange, mxp_frameoffset, mxp_frameendaction, mxp_flip_v);

    float2 uv = mxp_flip_v ? float2(mxp_texcoord.x, 1.0 - mxp_texcoord.y) : mxp_texcoord;
    // Map normalized UVs to texel-center coordinates: texel i is at (i + 0.5) / resolution.
    float2 texel_position = uv * float2(resolution) - 0.5;

    // Keep the existing gradient fallback outside the B-spline center domain.
    if (mxp_uaddressmode == core::mx_addressmode_type_constant
        && (texel_position.x < 0.0 || texel_position.x >= float(resolution.x)))
        return float2(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));
    if (mxp_vaddressmode == core::mx_addressmode_type_constant
        && (texel_position.y < 0.0 || texel_position.y >= float(resolution.y)))
        return float2(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));

    int2 cell = int2(math::floor(texel_position));
    float2 fraction = texel_position - math::floor(texel_position);
    mx_bspline_weights w_u = mx_compute_bspline_weights(fraction.x);
    mx_bspline_weights w_v = mx_compute_bspline_weights(fraction.y);
    uniform tex::wrap_mode wrap_u = core::map_addressmode(mxp_uaddressmode);
    uniform tex::wrap_mode wrap_v = core::map_addressmode(mxp_vaddressmode);

    float2 du = float2(0.0);
    float2 dv = float2(0.0);
    for (int j = 0; j < 4; ++j)
    {
        int y = mx_bspline_remap(cell.y + j - 1, resolution.y, wrap_v);
        float2 row_value = float2(0.0);
        float2 row_du = float2(0.0);
        for (int i = 0; i < 4; ++i)
        {
            int x = mx_bspline_remap(cell.x + i - 1, resolution.x, wrap_u);
            float2 sample = float2(tex::texel_float2(mxp_file, int2(x, y)));
            row_value += sample * w_u.value[i];
            row_du += sample * w_u.deriv[i];
        }
        du += row_du * w_v.value[j];
        dv += row_value * w_v.deriv[j];
    }

    // Convert texel derivatives to UV units, then to the application's derivative basis.
    du *= float(resolution.x);
    dv *= float(resolution.y);
    float2 dx = math::DX(uv);
    float2 dy = math::DY(uv);
    return float2(math::make_dual(value, du * dx.x + dv * dx.y, du * dy.x + dv * dy.y));
}

