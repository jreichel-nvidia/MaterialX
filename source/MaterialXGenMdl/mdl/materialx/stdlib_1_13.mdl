    if (mxp_vaddressmode == core::mx_addressmode_type_constant
        && (texel_position.y < 0.0 || texel_position.y >= float(resolution.y)))
        return float3(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));

