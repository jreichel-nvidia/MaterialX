    if (resolution.x <= 0 || resolution.y <= 0)
        return mxp_default;

    float4 value = stdlib_1_12::mx_image_vector4(
        mxp_file, mxp_layer, mxp_default, mxp_texcoord,
        mxp_uaddressmode, mxp_vaddressmode, mxp_filtertype,
        mxp_framerange, mxp_frameoffset, mxp_frameendaction, mxp_flip_v);

    float2 uv = mxp_flip_v ? float2(mxp_texcoord.x, 1.0 - mxp_texcoord.y) : mxp_texcoord;
    // Map normalized UVs to texel-center coordinates: texel i is at (i + 0.5) / resolution.
    float2 texel_position = uv * float2(resolution) - 0.5;

    // Keep the existing gradient fallback outside the B-spline center domain.
    if (mxp_uaddressmode == core::mx_addressmode_type_constant
        && (texel_position.x < 0.0 || texel_position.x >= float(resolution.x)))
        return float4(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));
    if (mxp_vaddressmode == core::mx_addressmode_type_constant
        && (texel_position.y < 0.0 || texel_position.y >= float(resolution.y)))
        return float4(math::make_dual(value, math::DX(mxp_default), math::DY(mxp_default)));

    int2 cell = int2(math::floor(texel_position));
    float2 fraction = texel_position - math::floor(texel_position);
    mx_bspline_weights w_u = mx_compute_bspline_weights(fraction.x);
    mx_bspline_weights w_v = mx_compute_bspline_weights(fraction.y);
    uniform tex::wrap_mode wrap_u = core::map_addressmode(mxp_uaddressmode);
    uniform tex::wrap_mode wrap_v = core::map_addressmode(mxp_vaddressmode);

    float4 du = float4(0.0);
    float4 dv = float4(0.0);
    for (int j = 0; j < 4; ++j)
    {
        int y = mx_bspline_remap(cell.y + j - 1, resolution.y, wrap_v);
        float4 row_value = float4(0.0);
        float4 row_du = float4(0.0);
        for (int i = 0; i < 4; ++i)
        {
            int x = mx_bspline_remap(cell.x + i - 1, resolution.x, wrap_u);
            float4 sample = float4(tex::texel_float4(mxp_file, int2(x, y)));
            row_value += sample * w_u.value[i];
            row_du += sample * w_u.deriv[i];
        }
