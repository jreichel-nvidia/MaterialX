    float2 dy = math::DY(uv);
    return float4(math::make_dual(value, du * dx.x + dv * dx.y, du * dy.x + dv * dy.y));
}

export color mx_image_with_derivatives_color3(
    uniform texture_2d mxp_file = texture_2d()
    [[
        anno::display_name("Filename")
    ]],
    uniform string mxp_layer = string("")
    [[
        anno::display_name("Layer")
    ]],
    color mxp_default = color(0.0, 0.0, 0.0)
    [[
        anno::display_name("Default Color")
    ]],
    float2 mxp_texcoord = float2(core::mx_swizzle_xy(::state::texture_coordinate(0)))
    [[
        anno::display_name("Texture Coordinates")
    ]],
    uniform core::mx_addressmode_type mxp_uaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode U")
    ]],
    uniform core::mx_addressmode_type mxp_vaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode V")
    ]],
    uniform core::mx_filterlookup_type mxp_filtertype
        = core::mx_filterlookup_type(core::mx_filterlookup_type_linear)
    [[
        anno::description("Enumeration {closest,linear,cubic}."),
        anno::display_name("Filter Type")
    ]],
    uniform string mxp_framerange = string("")
    [[
        anno::display_name("Frame Range")
    ]],
    uniform int mxp_frameoffset = int(0)
    [[
        anno::display_name("Frame Offset")
    ]],
    uniform core::mx_addressmode_type mxp_frameendaction
        = core::mx_addressmode_type(core::mx_addressmode_type_constant)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Frame End Action")
    ]],
    uniform bool mxp_flip_v = false
    [[
        anno::usage("for applying the 'fileTextureVerticalFlip' shader generator option."),
        anno::hidden()
    ]]
)
    [[
        anno::description("Node Group: texture2d")
    ]]
{
    return color(mx_image_with_derivatives_vector3(
        mxp_file, mxp_layer, float3(mxp_default), mxp_texcoord,
        mxp_uaddressmode, mxp_vaddressmode, mxp_filtertype,
        mxp_framerange, mxp_frameoffset, mxp_frameendaction, mxp_flip_v));
}

export core::color4 mx_image_with_derivatives_color4(
    uniform texture_2d mxp_file = texture_2d()
    [[
        anno::display_name("Filename")
    ]],
    uniform string mxp_layer = string("")
    [[
        anno::display_name("Layer")
    ]],
    core::color4 mxp_default = core::mk_color4(0.0, 0.0, 0.0, 0.0)
    [[
        anno::display_name("Default Color")
    ]],
    float2 mxp_texcoord = float2(core::mx_swizzle_xy(::state::texture_coordinate(0)))
    [[
        anno::display_name("Texture Coordinates")
    ]],
    uniform core::mx_addressmode_type mxp_uaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode U")
    ]],
    uniform core::mx_addressmode_type mxp_vaddressmode
        = core::mx_addressmode_type(core::mx_addressmode_type_periodic)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Address Mode V")
    ]],
    uniform core::mx_filterlookup_type mxp_filtertype
        = core::mx_filterlookup_type(core::mx_filterlookup_type_linear)
    [[
        anno::description("Enumeration {closest,linear,cubic}."),
        anno::display_name("Filter Type")
    ]],
    uniform string mxp_framerange = string("")
    [[
        anno::display_name("Frame Range")
    ]],
    uniform int mxp_frameoffset = int(0)
    [[
        anno::display_name("Frame Offset")
    ]],
    uniform core::mx_addressmode_type mxp_frameendaction
        = core::mx_addressmode_type(core::mx_addressmode_type_constant)
    [[
        anno::description("Enumeration {constant,clamp,periodic,mirror}."),
        anno::display_name("Frame End Action")
    ]],
    uniform bool mxp_flip_v = false
    [[
        anno::usage("for applying the 'fileTextureVerticalFlip' shader generator option."),
        anno::hidden()
    ]]
)
    [[
        anno::description("Node Group: texture2d")
    ]]
{
    return core::mk_color4(mx_image_with_derivatives_vector4(
        mxp_file, mxp_layer, core::mk_float4(mxp_default), mxp_texcoord,
        mxp_uaddressmode, mxp_vaddressmode, mxp_filtertype,
        mxp_framerange, mxp_frameoffset, mxp_frameendaction, mxp_flip_v));
}

export float3 mx_heighttonormal_with_derivatives(float height, float scale, float2 uv)
{
    // Scale factor for parity with traditional Sobel filtering.
    float SOBEL_SCALE_FACTOR = 1.0 / 16.0;
    float2 dhdxy = scale * SOBEL_SCALE_FACTOR * float2(math::DX(height), math::DY(height));
    float2 dudxy = float2(math::DX(uv.x), math::DY(uv.x));
    float2 dvdxy = float2(math::DX(uv.y), math::DY(uv.y));

    float3 tangent   = float3(dudxy.x, dvdxy.x, dhdxy.x);
    float3 bitangent = float3(dudxy.y, dvdxy.y, dhdxy.y);
    float3 normal    = math::cross(tangent, bitangent);

    if (math::dot(normal, normal) < 1.0e-16)
        return float3(0.5, 0.5, 1.0);

    return math::normalize(normal.z < 0.0 ? -normal : normal) * 0.5 + 0.5;
}
